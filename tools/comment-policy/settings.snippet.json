{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/comment-policy/block-inline-comments.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_COMMENT_POLICY": "redundant",
    "CLAUDE_COMMENT_NOTES": "docs/code-notes.md"
  }
}
